<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================
  Spring Modulith 模块化教学示例
  作者：xb  |  日期：2026-09-14
  说明：与主示例（技术分层架构）对照，本模块按【业务能力】组织代码——
        order（订单）/ inventory（库存）/ notification（通知）
        演示：模块边界验证、事件发布注册表、模块切片测试
  ============================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent><groupId>com.xb</groupId><artifactId>ddd-arch-demo</artifactId><version>1.0.0</version></parent>

    <artifactId>modulith</artifactId>
    <packaging>jar</packaging>
    <name>modulith</name>
    <description>Spring Modulith 模块化示例：按业务能力组织（作者 xb）</description>

    <properties>
        <!-- Spring Modulith 1.3.x 基线为 Spring Boot 3.4，与父工程 3.4.4 匹配 -->
        <spring-modulith.version>1.3.12</spring-modulith.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web + JPA -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
        <!-- 内存数据库：重启即清空，教学友好 -->
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>runtime</scope></dependency>

        <!-- Spring Modulith 核心：模块模型 + @ApplicationModuleListener -->
        <dependency><groupId>org.springframework.modulith</groupId><artifactId>spring-modulith-starter-core</artifactId></dependency>
        <!-- 事件发布注册表：基于 JPA 的 EVENT_PUBLICATION 表，可靠事件投递 -->
        <dependency><groupId>org.springframework.modulith</groupId><artifactId>spring-modulith-starter-jpa</artifactId></dependency>

        <!-- 测试 -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
        <!-- 模块切片测试：@ApplicationModuleTest + PublishedEvents -->
        <dependency><groupId>org.springframework.modulith</groupId><artifactId>spring-modulith-starter-test</artifactId><scope>test</scope></dependency>
        <!-- 文档生成：Documenter 输出 PlantUML 模块图 -->
        <dependency><groupId>org.springframework.modulith</groupId><artifactId>spring-modulith-docs</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals><goal>repackage</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
